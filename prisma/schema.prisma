// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  password     String
  isActive     Boolean  @default(true)
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions          Session[]
  tokenLimit        TokenLimit?
  conversations     Conversation[]
  tokenTransactions TokenTransaction[]

  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  accestoken   String    @map("acces_token")
  refreshToken String    @map("refresh_token")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  expireAt     DateTime? @map("expire_at")
  createdAt    DateTime  @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model TokenLimit {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  totalTokens     Int      @default(10) @map("total_tokens")
  usedTokens      Int      @default(0) @map("used_tokens")
  remainingTokens Int      @default(10) @map("remaining_tokens")
  resetAt         DateTime @map("reset_at")
  updatedAt       DateTime @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("token_limit")
}

model Conversation {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  title           String   @default("New Chat")
  model           String   @default("Ollama3.2")
  totalTokensUsed Int      @default(0) @map("total_tokens_used")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  
   @@index([userId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String      @map("conversation_id")
  role           MessageRole 
  content        String
  tokensUsed     Int         @default(0) @map("tokens_used")
  orderIndex     Int         @map("order_index")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  chunks       MessageChunk[]
  
 
  @@index([conversationId, orderIndex])
  @@map("messages")
}

model MessageChunk {
  id         String   @id @default(cuid())
  messageId  String   @map("message_id")
  chunkText  String   @map("chunk_text")
  embedding  String?
  chunkIndex Int      @map("chunk_index")
  createdAt  DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_chunks")
}

model TokenTransaction {
  id             String          @id @default(cuid())
  userId         String          @map("user_id")
  conversationId String?         @map("conversation_id")
  tokensUsed     Int             @map("tokens_used")
  model          String
  type           TransactionType
  createdAt      DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  

  @@index([userId, createdAt])
  @@index([conversationId])
  @@map("token_transactions")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum TransactionType {
  CHAT
  RESET
  BONUS
  DEDUCTION
}
